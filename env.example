# Copy to .env for local development. In production these are `fly secrets set`.

# Signs the login cookies. 32+ random chars. Changing it signs everyone out.
#   openssl rand -hex 32
COOKIE_SECRET=

# Where the lamp roster and credentials come from. Locally, leave this unset and
# use ./config.json. In production, set it to the whole file contents:
#   fly secrets set LAMPLINK_CONFIG="$(cat config.json)"
# LAMPLINK_CONFIG=

# PORT=8080
# MQTT_PORT=1883
# STATE_PATH=./data/state.json
# LOG_LEVEL=debug

# Allow non-HTTPS cookies. Only for local testing over plain http.
# INSECURE_COOKIES=1
